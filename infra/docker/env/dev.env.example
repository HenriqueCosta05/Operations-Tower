# Local dev: *.localhost resolves to 127.0.0.1 in browsers. On a VPS use nip.io,
# e.g. APP_HOST=app.203-0-113-10.nip.io (dots in the IP become dashes).
PUBLIC_SCHEME=http
APP_HOST=app.localhost
API_HOST=api.localhost
AUTH_HOST=auth.localhost
CADDY_GLOBAL_OPTIONS=auto_https off
IMAGE_TAG=dev

PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_API_TOKEN=change-me
