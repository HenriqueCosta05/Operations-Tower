PUBLIC_SCHEME=https
APP_HOST=app.stg.example.com
API_HOST=api.stg.example.com
AUTH_HOST=auth.stg.example.com
ACME_EMAIL=you@example.com
# Staging certificates avoid Let's Encrypt rate limits; browsers will warn about them.
CADDY_GLOBAL_OPTIONS=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

IMAGE_REGISTRY=ghcr.io/your-github-user/operations-tower
IMAGE_TAG=stg

PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_API_TOKEN=change-me
